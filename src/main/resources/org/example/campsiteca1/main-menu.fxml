<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" prefHeight="720.0" prefWidth="1100.0" stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/26" fx:controller="org.example.campsiteca1.MainController">

    <top>
        <VBox>
            <children>
                <MenuBar>
                    <menus>
                        <Menu text="File">
                            <items>
                                <MenuItem fx:id="saveMenuItem" text="Save data"/>
                                <MenuItem fx:id="loadMenuItem" text="Load data"/>
                                <SeparatorMenuItem/>
                                <MenuItem fx:id="resetMenuItem" text="Reset all data"/>
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>
                <VBox alignment="CENTER" spacing="6.0">
                    <padding>
                        <Insets bottom="8.0" top="36.0"/>
                    </padding>
                    <children>
                        <Label styleClass="hero-title" text="Campsite Manager"/>
                        <Label styleClass="subtitle"
                               text="Set up campsites, look after guests and keep every booking in order."/>
                    </children>
                </VBox>
            </children>
        </VBox>
    </top>

    <!-- Left button -->
    <left>
        <VBox alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets left="48.0"/>
            </BorderPane.margin>
            <children>
                <Button fx:id="campsitesButton" mnemonicParsing="false" onAction="#changeCampsite" prefHeight="110.0"
                        prefWidth="230.0" styleClass="menu-tile" text="Campsites"/>
                <Label styleClass="muted" text="Campsites, areas and plots"/>
            </children>
        </VBox>
    </left>

    <!-- Centre picture: set the Image property on heroImage (or in your controller) -->
    <center>
        <StackPane maxHeight="340.0" maxWidth="480.0" prefHeight="340.0" prefWidth="480.0" styleClass="image-frame"
                   BorderPane.alignment="CENTER">
            <children>
                <ImageView fx:id="heroImage" fitHeight="320.0" fitWidth="460.0" pickOnBounds="true"
                           preserveRatio="true">
                    <image>
                        <Image url="@../../../images/Background.png"/>
                    </image>
                </ImageView>
            </children>
        </StackPane>
    </center>

    <!-- Right button -->
    <right>
        <VBox alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets right="48.0"/>
            </BorderPane.margin>
            <children>
                <Button fx:id="guestsBookingsButton" mnemonicParsing="false" onAction="#changeGuest" prefHeight="110.0"
                        prefWidth="230.0" styleClass="menu-tile" text="Guests &amp; Bookings"/>
                <Label styleClass="muted" text="Guests, bookings and smart find"/>
            </children>
        </VBox>
    </right>

    <bottom>
        <Label styleClass="muted" text="Save, load and reset are in the File menu." BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets bottom="24.0" top="12.0"/>
            </BorderPane.margin>
        </Label>
    </bottom>
</BorderPane>
